{
  "name": "openfasttrace-lsp",
  "displayName": "OpenFastTrace Language Server",
  "description": "Connects VS Code to the OpenFastTrace Language Server for requirement tracing.",
  "version": "0.1.0",
  "publisher": "felixgorke",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  }
}
