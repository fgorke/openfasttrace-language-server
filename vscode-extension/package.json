{
  "name": "openfasttrace-lsp",
  "displayName": "OpenFastTrace Language Server",
  "description": "Integrates the OpenFastTrace (OFT) language server into VS Code via the Language Server Protocol.",
  "version": "0.2.0",
  "publisher": "felixgorke",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "precompile": "npm run copy-server-jar",
    "prewatch": "npm run copy-server-jar",
    "copy-server-jar": "node scripts/copy-server-jar.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  },
  "contributes": {
    "configuration": {
      "title": "OpenFastTrace Language Server",
      "properties": {
        "oft.java.path": {
          "type": "string",
          "default": "java",
          "description": "Path to the java executable used to run the language server. Defaults to 'java' on PATH."
        }
      }
    },
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "[markdown]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[java]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[kotlin]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[c]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[cpp]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[python]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[javascript]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[typescript]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[ruby]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[go]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[rust]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } },
      "[csharp]": { "editor.quickSuggestions": { "other": true, "comments": true, "strings": false } }
    }
  }
}
